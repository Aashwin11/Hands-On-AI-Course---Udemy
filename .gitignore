# Ignore .env files in any directory or sub-directory
**/.env

# Optional: Also ignore common variations
**/.env.local
**/.env.development
**/.env.test
**/.env.production
.vscode


# Ignore all virtual environments (any folder containing "env")
*env*/

# Also ignore common venv naming patterns explicitly (good practice)
venv/
.env/
ENV/
env/